# local-only scratch/reference directories (prototypes, backups, working
# notes, generated review artifacts, deploy docs, etc.) — anything at the
# repo root starting with an underscore. Trailing slash keeps this to
# directories only, since leading-underscore *files* are sometimes part of
# real JS project layouts (see the individual file exceptions below).
/_*/

# OS / editor
.DS_Store
*.swp

# node (library has no runtime deps, but tooling may add a node_modules locally)
node_modules/

# bu
_buignore


# vim backup
*~

# hidden files
.*
